# ── Telegram bot (обязательно) ────────────────────────────────
BOT_TOKEN=
OPERATOR_CHAT_ID=

# ── Claude CLI OAuth (подписка Claude Pro, НЕ API) ────────────
# Long-lived токен из `claude setup-token` (формат sk-ant-oat01-…, живёт ~1 год).
# CLAUDE_REFRESH_TOKEN оставь ПУСТЫМ → статик-режим: teplodar не рефрешит и не
# читает общий data/.claude_token.json. Детали — CLAUDE.md «Claude CLI auth».
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_REFRESH_TOKEN=
# CLAUDE_CLI_PATH=claude
# CLAUDE_MODEL=claude-sonnet-4-6   # пусто = дефолт из config.py (Sonnet 4.6), не «дефолт CLI»

# ── База знаний (папка base/) ─────────────────────────────────
DATABASE_PATH=base/teplodar.db
PDF_STORAGE_PATH=base/pdfs/

# ── Logging ────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Каталог: синхронизация с сайтом (scripts/sync_catalog.py, cron) ──
# Постоянная ссылка на YML-фид Битрикса; сайт пересобирает его раз в сутки.
# Пусто = по расписанию ничего не качается, только ручной импорт файла.
YANDEX_YML_URL=https://www.teplodar.ru/bitrix/catalog_export/bot.xml
# Защита от битого фида: если в фиде меньше этой доли от текущих активных
# товаров — синхронизация прерывается, ничего не деактивируется.
# CATALOG_SYNC_MIN_RATIO=0.5

# ── Ingestion (только при локальном парсинге каталога) ────────
YANDEX_YML_PATH=yandex_yml_base.xml
HTTP_TIMEOUT=30
HTTP_RETRY_ATTEMPTS=3
RATE_LIMIT_DELAY=1.0
MAX_CONCURRENT_REQUESTS=3
USER_AGENT=TeplodarKnowledgeBot/0.1 (+contact@example.com)

# ── RAG (значения по умолчанию подходят) ──────────────────────
# EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
# EMBEDDING_DIM=768
# CHUNK_SIZE_TOKENS=400
# CHUNK_OVERLAP_TOKENS=80
# TOP_K=8
# INDEX_VERSION=e5-base-v1
# DEVICE=cpu
# BATCH_SIZE_EMBEDDING=32

# Bitrix24 webhook (see BITRIX24.md). Envelope secret from the Б24 portal —
# arrives as auth[application_token] in every event. Empty = webhook disabled (503).
B24_APPLICATION_TOKEN=
# data[bot][id] of the registered bot (511 on teplodar.bitrix24.ru)
B24_BOT_ID=0
# Handoff target: empty = first free operator; "queue<ID>" or user id = imopenlines.bot.session.transfer
B24_TRANSFER_TO=
# Wait this many seconds after the client's last message and answer the burst together
# B24_DEBOUNCE_SECONDS=6
